# Copiar a .env.local y completar con valores reales. Nunca commitear
# .env.local ni valores reales de producción a este repositorio.

# Clave PÚBLICA del SDK de Mercado Pago (checkout embebido / Wallet Brick).
# Es segura de exponer en el frontend — la clave PRIVADA (access token)
# vive únicamente en el servidor/automatización que crea la preferencia
# de pago, nunca aquí.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ID del Google Sheet que usa n8n como fuente del catálogo (solo
# referencia/documentación — la lectura real la hace el workflow de n8n,
# no este sitio en tiempo de build).
GOOGLE_SHEETS_ID=

# Secreto compartido para el webhook de sincronización manual del
# catálogo, si se expone uno. Vive en n8n y en el servidor, nunca en el
# cliente.
N8N_WEBHOOK_SECRET=

# Clave del sitio para reCAPTCHA v3 en el formulario de checkout.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
